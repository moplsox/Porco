  "cgs": {
    "letter": {
      "src": "assets/cg-letter.png",
      "title": "不用去了",
      "composition": "清晨右侧海湾红机；波鲁克齐膝站在水中，菲尔在背后递出一支铅笔；信封在机翼暖光里。",
      "placeholder": false,
      "styleVersion": "film-review-v10"
    },
    "yellow-quilt": {
      "src": "assets/cg-yellow-quilt.png",
      "title": "星期天的渡轮",
      "composition": "两人靠左侧船栏，菲尔把望远镜递给波鲁克，视线引向岸上巨大黄被子，晴天顶光。",
      "placeholder": false,
      "styleVersion": "film-reference-v2"
    },
    "dinner-fio": {
      "src": "assets/cg-dinner-fio.png",
      "title": "试飞后的晚餐",
      "composition": "餐馆暖灯，菲尔新裙子与指甲机油同时可见，波鲁克把旧客户的注视引回她，桌边留出她的发言位置。",
      "placeholder": false,
      "styleVersion": "film-reference-v2"
    },
    "kitchen": {
      "src": "assets/cg-kitchen.png",
      "title": "最后一盘凉菜",
      "composition": "暖灯从桌上照下，窄桌与两人，吉娜脱鞋，桌下并排飞行靴和高跟鞋，冷菜蓝盘，背后月光。",
      "placeholder": false,
      "styleVersion": "film-reference-v2"
    },
    "silence": {
      "src": "assets/cg-silence.png",
      "title": "无人点歌的傍晚",
      "composition": "橙色落日，平静小船，吉娜不唱歌，双手自然搭着船沿；波鲁克放下划桨，两人共享海面的静默。",
      "placeholder": false,
      "styleVersion": "film-review-v10"
    },
    "dock": {
      "src": "assets/cg-dock.png",
      "title": "一条能推轮椅的坡道",
      "composition": "白昼码头斜坡，菲尔蹲看水位与卷尺，吉娜拿账本核工费；波鲁克在边缘扶木料，生活与工程的交点。",
      "placeholder": false,
      "styleVersion": "film-review-v10"
    },
    "mailbag": {
      "src": "assets/cg-mailbag.png",
      "title": "被风吹走的邮袋",
      "composition": "低角度礁石上的旧邮袋开了缝，露出一封浅黄信，远处另一座岛与红机；风、距离和待履行约定同时在场。",
      "placeholder": false,
      "styleVersion": "film-review-v10"
    },
    "storm": {
      "src": "assets/cg-storm.png",
      "title": "没有起飞的那一天",
      "composition": "暴雨帘外没有飞机起飞，机库里三个人围着桌上天气图与保温壶；彼此的位置留有呼吸空间。",
      "placeholder": false,
      "styleVersion": "film-reference-v2",
      "unlock": "common_d66_gap"
    },
    "first-flight": {
      "src": "assets/cg-first-flight.png",
      "title": "在机首签字的人",
      "composition": "首航后照片，菲尔独立站在机首拿正式飞行记录，正面日光；波鲁克仅在右边缘露半只扶梯的手。",
      "placeholder": false,
      "styleVersion": "film-review-v10",
      "unlock": "common_d81_firstflight / friend"
    },
    "key": {
      "src": "assets/cg-key.png",
      "title": "侧门的钥匙",
      "composition": "旅馆侧门暖灯，吉娜晨装手心朝上递出黄铜钥匙；波鲁克手掌有修桌留下的木屑，不需漂亮话。",
      "placeholder": false,
      "styleVersion": "film-reference-v2"
    },
    "garden": {
      "src": "assets/cg-garden.png",
      "title": "花园里留下的座位",
      "composition": "第51天夜，旅馆暖窗光落在花园的旧椅、两杯咖啡和相邻的帽子上；不展示波鲁克的人脸，不替赌约标日期。",
      "placeholder": false,
      "styleVersion": "film-review-v10"
    },
    "last-boat": {
      "src": "assets/cg-last-boat.png",
      "title": "夏末最后一班船",
      "composition": "夕阳里末班船离港，三人背影站码头；信袋、工具箱和账本各自留在手里，仍有秋天要过。",
      "placeholder": false,
      "styleVersion": "film-reference-v2"
    },
    "fio-swimming": {
      "src": "assets/cg-fio-swimming.png",
      "styleVersion": "film-review-v10",
      "placeholder": false,
      "title": "游过海湾",
      "composition": "成年菲尔游过安静的浅湾，侧头抬臂向岸上的波鲁克招呼。湿发、正常长度白上衣与白色中腿短裤，在白日海光里连着一段工作以外的约会。",
      "unlock": "fio_swim_water"
    }
  },
